/* app.wxss */
page {
  --primary: #e94560;
  --primary-dark: #c73e54;
  --secondary: #16213e;
  --accent: #0f3460;
  --bg: #f5f5f5;
  --card-bg: #ffffff;
  --text: #1a1a2e;
  --text-secondary: #666;
  --text-light: #999;
  --border: #e8e8e8;
  --success: #52c41a;
  --warning: #faad14;
  --danger: #ff4d4f;
  
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  background-color: var(--bg);
  color: var(--text);
}

.container {
  padding: 20rpx 30rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 卡片样式 */
.card {
  background: var(--card-bg);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
  color: var(--text);
}

.card-subtitle {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 16rpx;
}

/* 按钮样式 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  transition: all 0.2s;
}

.btn-primary {
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  color: #fff;
}

.btn-primary:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.btn-secondary {
  background: var(--secondary);
  color: #fff;
}

.btn-outline {
  background: transparent;
  border: 2rpx solid var(--primary);
  color: var(--primary);
}

.btn-sm {
  height: 64rpx;
  font-size: 26rpx;
  padding: 0 32rpx;
}

/* 标签样式 */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 20rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.tag-primary {
  background: rgba(233, 69, 96, 0.1);
  color: var(--primary);
}

.tag-secondary {
  background: rgba(22, 33, 62, 0.08);
  color: var(--secondary);
}

.tag-success {
  background: rgba(82, 196, 26, 0.1);
  color: var(--success);
}

/* 评分星星 */
.stars {
  display: flex;
  gap: 8rpx;
}

.star {
  font-size: 32rpx;
  color: #ddd;
}

.star.active {
  color: #faad14;
}

/* 列表项 */
.list-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.list-item:last-child {
  border-bottom: none;
}

.list-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  font-size: 36rpx;
}

.list-content {
  flex: 1;
}

.list-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.list-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.list-arrow {
  font-size: 28rpx;
  color: var(--text-light);
}

/* 网格 */
.grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.grid-item {
  background: var(--card-bg);
  border-radius: 20rpx;
  padding: 30rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}

/* 输入框 */
.input-group {
  margin-bottom: 24rpx;
}

.input-label {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
  display: block;
}

.input-field {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border: 2rpx solid var(--border);
  border-radius: 16rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  background: var(--card-bg);
}

.textarea-field {
  width: 100%;
  min-height: 200rpx;
  padding: 20rpx 24rpx;
  border: 2rpx solid var(--border);
  border-radius: 16rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  background: var(--card-bg);
}

/* 步骤条 */
.steps {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0 40rpx;
}

.step {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.step-dot {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #fff;
  margin-bottom: 8rpx;
}

.step.active .step-dot {
  background: var(--primary);
}

.step.completed .step-dot {
  background: var(--success);
}

.step-line {
  position: absolute;
  top: 18rpx;
  left: 50%;
  right: -50%;
  height: 4rpx;
  background: var(--border);
}

.step.active .step-line,
.step.completed .step-line {
  background: var(--primary);
}

.step-label {
  font-size: 22rpx;
  color: var(--text-light);
}

.step.active .step-label {
  color: var(--primary);
}

/* 动画 */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.animate-fade-in {
  animation: fadeIn 0.4s ease-out;
}
