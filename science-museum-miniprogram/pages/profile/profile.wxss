/* pages/profile/profile.wxss */
.user-section {
  display: flex;
  align-items: center;
  padding: 40rpx 30rpx;
  margin-bottom: 20rpx;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.user-avatar image {
  width: 100%;
  height: 100%;
}

.user-info {
  flex: 1;
}

.user-name {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.user-tag {
  display: block;
  font-size: 24rpx;
  color: var(--primary);
}

/* 统计网格 */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.stat-item {
  background: var(--card-bg);
  border-radius: 20rpx;
  padding: 30rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}

.stat-number {
  display: block;
  font-size: 48rpx;
  font-weight: 800;
  color: var(--primary);
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 能力列表 */
.ability-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.ability-item {
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--border);
}

.ability-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.ability-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.ability-name {
  font-size: 28rpx;
  font-weight: 600;
}

.ability-score {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--primary);
}

.ability-bar {
  height: 12rpx;
  background: #f0f0f0;
  border-radius: 6rpx;
  overflow: hidden;
}

.ability-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--primary), var(--primary-dark));
  border-radius: 6rpx;
  transition: width 0.8s ease-out;
}

/* 历史记录 */
.history-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.history-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.history-item:last-child {
  border-bottom: none;
}

.history-left {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.history-module {
  font-size: 28rpx;
  font-weight: 600;
}

.history-task {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.history-right {
  text-align: right;
}

.history-score {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--primary);
}

.history-date {
  font-size: 22rpx;
  color: var(--text-light);
}

/* 设置 */
.settings-card {
  margin-top: 20rpx;
}

.setting-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.setting-name {
  flex: 1;
  font-size: 28rpx;
}

.setting-value {
  font-size: 26rpx;
  color: var(--text-light);
  margin-right: 16rpx;
}
