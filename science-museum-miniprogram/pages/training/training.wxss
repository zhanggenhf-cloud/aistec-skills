/* pages/training/training.wxss */
/* 模块列表 */
.module-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.module-row {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #fafafa;
  border-radius: 16rpx;
  transition: all 0.2s;
}

.module-row:active {
  background: #f0f0f0;
  transform: scale(0.99);
}

.module-row-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.module-row-info {
  flex: 1;
}

.module-row-name {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 6rpx;
}

.module-row-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 任务列表 */
.task-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.task-item {
  padding: 30rpx;
  background: #fafafa;
  border-radius: 16rpx;
  border-left: 8rpx solid var(--primary);
  transition: all 0.2s;
}

.task-item:active {
  background: #f0f0f0;
  transform: scale(0.99);
}

.task-type {
  display: inline-block;
  padding: 4rpx 16rpx;
  background: var(--primary);
  color: #fff;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.task-name {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.task-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 题目区 */
.question-box {
  background: #f8f9fa;
  border-radius: 16rpx;
  padding: 24rpx;
}

.question-label {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--primary);
  margin-bottom: 12rpx;
}

.question-content {
  font-size: 28rpx;
  line-height: 1.8;
  color: var(--text);
  white-space: pre-wrap;
}

.question-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

/* 评分结果 */
.score-card {
  text-align: center;
  padding: 40rpx;
}

.score-circle {
  display: inline-flex;
  align-items: baseline;
  justify-content: center;
}

.score-number {
  font-size: 80rpx;
  font-weight: 800;
  color: var(--primary);
}

.score-total {
  font-size: 36rpx;
  color: var(--text-light);
}

.score-label {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin: 8rpx 0 16rpx;
}

/* 维度得分 */
.dimension-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.dimension-item {
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--border);
}

.dimension-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.dimension-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.dimension-name {
  font-size: 28rpx;
  font-weight: 600;
}

.dimension-score {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--primary);
}

.dimension-bar {
  height: 12rpx;
  background: #f0f0f0;
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.dimension-fill {
  height: 100%;
  border-radius: 6rpx;
  transition: width 0.8s ease-out;
}

.dimension-comment {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 总结 */
.summary-text {
  display: block;
  font-size: 28rpx;
  line-height: 1.8;
  color: var(--text);
  margin-bottom: 24rpx;
}

.suggestions {
  background: #fff7e6;
  border-radius: 16rpx;
  padding: 24rpx;
}

.suggestion-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #d48806;
  margin-bottom: 12rpx;
}

.suggestion-item {
  display: flex;
  gap: 12rpx;
  font-size: 26rpx;
  color: var(--text);
  line-height: 1.6;
  margin-bottom: 8rpx;
}

.suggestion-dot {
  color: #d48806;
  font-weight: 700;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.action-buttons .btn {
  flex: 1;
}
