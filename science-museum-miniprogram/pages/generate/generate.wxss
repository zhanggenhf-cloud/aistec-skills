/* pages/generate/generate.wxss */
.generate-module-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.generate-module-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #fafafa;
  border-radius: 16rpx;
  transition: all 0.2s;
}

.generate-module-item:active {
  background: #f0f0f0;
  transform: scale(0.99);
}

.generate-module-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.generate-module-info {
  flex: 1;
}

.generate-module-name {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 4rpx;
}

.generate-module-template {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 表单 */
.form {
  margin-bottom: 20rpx;
}

.picker-field {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border: 2rpx solid var(--border);
  border-radius: 16rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  background: var(--card-bg);
}

.picker-arrow {
  font-size: 20rpx;
  color: var(--text-light);
}

/* 结果 */
.result-card {
  padding: 0;
  overflow: hidden;
}

.result-header {
  padding: 30rpx;
  border-bottom: 1rpx solid var(--border);
}

.result-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 12rpx;
}

.result-time {
  font-size: 22rpx;
  color: var(--text-light);
}

.result-content {
  padding: 30rpx;
  font-size: 28rpx;
  line-height: 1.8;
  color: var(--text);
  white-space: pre-wrap;
  background: #fafafa;
  max-height: 800rpx;
  overflow-y: auto;
}

.result-actions {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 30rpx;
  border-top: 1rpx solid var(--border);
}

.result-actions .btn {
  flex: 1;
}
